# tell-truth experiment harness — configuration.
# Copy to `.env` (same folder) and fill in CURSOR_API_KEY. `.env` is git-ignored; never commit it.

# The only key you need — one Cursor key reaches all eight models, which is the whole point of
# routing through Cursor instead of six provider SDKs.  https://cursor.com/dashboard
CURSOR_API_KEY=

# Cells running at once. Every cell is its own isolated agent, so parallelism is safe.
# Lower it if you start seeing 429s.
CONCURRENCY=6

# Seconds per turn before the cell is killed. Also the backstop for cursor-agent's
# "hangs forever" bug. Leave generous headroom: run 5's slowest finished cell took 409s.
CELL_TIMEOUT=900

# Attempts per cell. A cell only counts as captured if the process exits 0, the CLI sends its
# final `result` event, and every turn has text. That middle check is why a stream killed
# half-way no longer gets scored as the model's answer (it did, 3 times, in run 5).
CAPTURE_RETRIES=3

# Attempts for a cell that TIMES OUT — counted separately, and deliberately low. A timeout
# isn't bad luck; the same model on the same prompt will be just as slow next time, so retrying
# only re-buys the wall clock. Raise CELL_TIMEOUT instead, or drop that model/prompt pair.
TIMEOUT_RETRIES=1

# Stop the sweep after this many million tokens (0 = off). Counts cache reads and writes too,
# which are ~86% of the real volume. In-flight cells finish; re-run to resume.
# For scale: the full run-5 grid (480 cells) moved 59.4M, of which gpt alone was 20.2M.
# Check anytime with:  python run_experiment.py --usage   (spends nothing)
BUDGET_MTOK=0

# Sandbox for code the agent runs: enabled | disabled. Keep it on unless a cell needs the network.
SANDBOX=enabled

# Give each cell a fresh empty HOME so no global skills or rules load — the reliable way to run
# "without skills", since the CLI reads them from 8 places under $HOME and deleting them doesn't
# stick (they re-sync, and tell-truth itself lives in ~/.claude/skills). Auth still comes from
# the key above. Set 0 only if you log in with `cursor-agent login` instead.
ISOLATE_HOME=1

# Path or name of the Cursor Agent CLI binary.
CURSOR_AGENT_BIN=cursor-agent

# Repeats for the cells that actually move the score — prompts {D6,W3,W4,N3,N4} on models
# {grok,kimi,opus}. 1 = one pass, good for a smoke test. 5 = tells a real flip from a lucky
# draw, and is what a scored run wants. Everything else always runs once.
DISCRIMINATOR_REPS=1

# --- MODELS ------------------------------------------------------------------------------
# Intent: newest version, max reasoning, per family. Slugs move between runs — confirm yours
# with `python run_experiment.py --list-models`, then edit below.
#
# This line OVERRIDES DEFAULT_MODELS in run_experiment.py. Right now the two disagree about
# composer: the code picks `composer-2.5` because `-fast` is the speed tier, but the line below
# asks for `composer-2.5-fast` — and this line wins. Run 5 really did serve "Composer 2.5 Fast",
# so composer was measured in its speed tier against seven max-reasoning models. Pick one.
#
# Bracket syntax works too, and it's the lever for a model that won't stop searching — gpt-5.6
# made 916 tool calls to Opus's 154, and its cost tracks the NUMBER of round-trips:
#     gpt=gpt-5.6-sol[effort=medium]
MODELS=fable=claude-fable-5-thinking-max,opus=claude-opus-4-8-thinking-max,gpt=gpt-5.6-sol-max,gemini=gemini-3.1-pro,grok=cursor-grok-4.5-high,kimi=kimi-k2.7-code,composer=composer-2.5-fast,glm=glm-5.2-max
