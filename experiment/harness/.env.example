# tell-truth experiment harness — configuration.
# Copy to `.env` (same folder) and fill in CURSOR_API_KEY. `.env` is git-ignored by default;
# do NOT commit your real key.

# The ONLY key you need. One Cursor API key reaches all seven models (Fable, Opus, GPT,
# Gemini, Grok, Kimi, Composer) — that is the whole point of routing through Cursor instead
# of six separate provider SDKs. Create one at:  https://cursor.com/dashboard  (Integrations / API Keys)
CURSOR_API_KEY=

# How many cells run at once (parallel `cursor-agent` subprocesses). Cross-model + within-model
# parallelism is safe: every cell is a fresh isolated agent. Lower this if you hit rate limits (429).
CONCURRENCY=6

# Per-turn wall-clock timeout in seconds. A turn exceeding this is killed and the cell retried.
# (cursor-agent -p has a known "hangs forever" edge case — this is the backstop.)
CELL_TIMEOUT=420

# Max attempts per cell. The validation gate requires a non-empty final answer (and, for the
# two-turn prompts D3/W6/N6, both turns). After this many misses the cell is written CAPTURE_FAILED.
CAPTURE_RETRIES=3

# Local code-exec sandbox for the agent: enabled | disabled. Keep enabled (safe execution of
# N1/N6 code) unless a cell genuinely needs host network access.
SANDBOX=enabled

# Run each cell with an isolated HOME so NO global skills/rules load. This is the reliable way
# to run "without skills": the CLI reads skills from 8 locations under $HOME (~/.cursor/skills,
# ~/.claude/skills, ~/.codex/skills, ~/.agents/skills, ...) and deleting them doesn't stick --
# they re-sync, and tell-truth also lives in ~/.claude/skills. Pointing HOME at a fresh empty
# dir hides all of them at once (auth still comes from CURSOR_API_KEY above). 1 = on (default).
# Set 0 ONLY if you authenticate via `cursor-agent login` (its session lives under real ~/.cursor).
ISOLATE_HOME=1

# Path/name of the Cursor Agent CLI binary.
CURSOR_AGENT_BIN=cursor-agent

# Statistical depth on the cells that actually move the binary score: the discriminator prompts
# {D6,W3,W4,N3,N4} on the mover models {grok,kimi,opus}. 1 = single run everywhere (fast, good
# for a smoke of the whole battery). 5 = replicate those cells 5x so a real flip can be told from
# a lucky draw (recommended for a scored run). Everything else always runs once.
DISCRIMINATOR_REPS=1

# --- MODELS: most advanced thinking / newest versions ----------------------------------------
# The roster below is the default. Confirm the exact slugs your account can use with:
#     python run_experiment.py --list-models
# then edit here. Format: key=slug,key=slug  (keys: fable opus gpt gemini grok kimi composer)
MODELS=fable=claude-fable-5-thinking-max,opus=claude-opus-4-8-thinking-max,gpt=gpt-5.5-extra-high,gemini=gemini-3.1-pro,grok=grok-4.3,kimi=kimi-k2.7-code,composer=composer-2.5-fast
